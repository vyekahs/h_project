{
    email {$EMAIL}
}

damonpyo.mooo.com {
    handle /api/ble/report {
        reverse_proxy ble-server:3001
    }
    # ble-server가 내부망(:8080)으로만 호출하는 경로 — 공개 도메인에서는 완전 차단.
    # (API 키만으로는 부족: 키가 새어나가도 이 경로 자체가 공개망에서 안 보이게)
    handle /api/internal/* {
        respond 404
    }
    handle {
        import active_app.caddy
    }
}

honnol.org {
    handle /api/ble/report {
        reverse_proxy ble-server:3001
    }
    # ble-server가 내부망(:8080)으로만 호출하는 경로 — 공개 도메인에서는 완전 차단.
    # (API 키만으로는 부족: 키가 새어나가도 이 경로 자체가 공개망에서 안 보이게)
    handle /api/internal/* {
        respond 404
    }
    handle {
        import active_app.caddy
    }
}

# 내부 전용 리스너 — ble-server가 app:3000을 직접 보지 않고 여기를 거쳐서
# 항상 지금 활성인 블루/그린 슬롯으로 연결되도록 한다. 도메인 없이 도커
# 네트워크 안에서만(호스트 포트 노출 없음) 접근 가능하다.
:8080 {
    import active_app.caddy
}
