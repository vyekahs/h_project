    "--color-orange": { "light": "#ff9800", "dark": "#ffb74d" },
    "--color-orange-dark": { "light": "#e67700", "dark": "#ff9800" },

    "--color-success-bg": { "light": "#e8f5e9", "dark": "rgba(34,197,94,0.12)" },
    "--color-error-bg": { "light": "#fff5f5", "dark": "rgba(239,68,68,0.12)" },
    "--color-warning-bg": { "light": "#fff3e0", "dark": "rgba(251,191,36,0.12)" },
    "--color-info-bg": { "light": "#e7f5ff", "dark": "rgba(59,130,246,0.12)" }
  },

  "mappings": {
