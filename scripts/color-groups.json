    "--bg-dark": { "light": "#333", "dark": "#e5e7eb" },

    "--border-default": { "light": "#ddd", "dark": "#3e4044" },
    "--border-light": { "light": "#eee", "dark": "#2c2e33" },
    "--border-medium": { "light": "#ccc", "dark": "#4b5563" },

    "--shadow-sm": { "light": "rgba(0,0,0,0.03)", "dark": "rgba(0,0,0,0.2)" },
    "--shadow-md": { "light": "rgba(0,0,0,0.1)", "dark": "rgba(0,0,0,0.3)" },
    "--shadow-lg": { "light": "rgba(0,0,0,0.15)", "dark": "rgba(0,0,0,0.4)" },
    "--shadow-heavy": { "light": "rgba(0,0,0,0.3)", "dark": "rgba(0,0,0,0.5)" },
    "--shadow-deep": { "light": "rgba(0,0,0,0.6)", "dark": "rgba(0,0,0,0.7)" },

    "--overlay-light": { "light": "rgba(0,0,0,0.05)", "dark": "rgba(255,255,255,0.05)" },
    "--overlay-medium": { "light": "rgba(0,0,0,0.2)", "dark": "rgba(0,0,0,0.4)" },
    "--overlay-heavy": { "light": "rgba(0,0,0,0.5)", "dark": "rgba(0,0,0,0.6)" },

    "--color-slate": { "light": "#94a3b8", "dark": "#94a3b8" },
    "--color-slate-dark": { "light": "#64748b", "dark": "#94a3b8" },

    "--color-blue": { "light": "#339af0", "dark": "#4dabf7" },
    "--color-blue-bright": { "light": "#007bff", "dark": "#4dabf7" },
    "--color-amber": { "light": "#fbbf24", "dark": "#fbbf24" },
    "--color-amber-dark": { "light": "#f59e0b", "dark": "#f59e0b" },
    "--color-amber-darker": { "light": "#d97706", "dark": "#f59e0b" },
    "--color-green": { "light": "#22c55e", "dark": "#34d399" },
