        "background-color": "--bg-primary",
        "color": "--bg-primary",
        "border": "--bg-primary",
        "_default": "--bg-primary"
      },
      "black": {
        "color": "--text-primary",
        "background": "--bg-dark",
        "background-color": "--bg-dark",
        "border": "--text-primary",
        "_default": "--text-primary"
      }
    },

    "rgba_shadows": {
      "rgba(0,0,0,0.03)": "--shadow-sm",
      "rgba(0,0,0,0.05)": "--overlay-light",
      "rgba(0,0,0,0.1)": "--shadow-md",
      "rgba(0,0,0,0.15)": "--shadow-lg",
      "rgba(0,0,0,0.3)": "--shadow-heavy",
      "rgba(0,0,0,0.6)": "--shadow-deep"
    },

    "rgba_overlays": {
      "rgba(0,0,0,0.2)": "--overlay-medium",
      "rgba(0,0,0,0.5)": "--overlay-heavy"
    }
  },

  "exclude_patterns": [
    "src/routes/minigames/tichu/",
    "src/routes/admin/",
    "src/routes/+layout.svelte"
  ],

  "exclude_colors": [
    "#111", "#000", "transparent",
    "#1e293b",
    "#364fc7"
  ],

  "_notes": [
    "2차 확장: exclude_colors에서 고빈도 색상을 매핑으로 이동",
    "#fff: context-aware (bg→--bg-primary, border→--border-light)",
    "#444: --text-primary로 통합",
    "#94a3b8, #64748b: --color-slate 계열",
    "#9ca3af, #6b7280, #4b5563, #1f2937 등 Tailwind 계열 회색 매핑 추가",
    "#228be6, #3b82f6, #60a5fa, #4c6ef5: --color-blue 통합",
    "#fcd34d, #ffd43b, #fab005: --color-amber 통합",
    "#f87171, #ff6b6b, #fa5252: --color-red 통합",
    "#dc2626, #e03131, #c62828, #c92a2a: --color-red-dark 통합",
    "#4caf50: --color-green, #2e7d32: --color-green-dark",
    "rgba(0,0,0,0.3): --shadow-heavy, rgba(0,0,0,0.6): --shadow-deep",
    "+layout.svelte는 exclude_patterns에 추가 (CSS 변수 정의 보호)"
  ]
