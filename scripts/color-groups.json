{
  "_comment": "하드코딩 색상 → CSS 변수 매핑. 'exact' 매핑만 수행 (유사색 추정 X)",
  "_strategy": "context-aware: 같은 색상이라도 사용 컨텍스트에 따라 다른 변수로 매핑",

  "variables": {
    "--text-primary": { "light": "#333", "dark": "#e5e7eb" },
    "--text-secondary": { "light": "#666", "dark": "#9ca3af" },
    "--text-tertiary": { "light": "#888", "dark": "#6b7280" },
    "--text-muted": { "light": "#999", "dark": "#6b7280" },
    "--text-hint": { "light": "#adb5bd", "dark": "#4b5563" },
    "--text-dark": { "light": "#495057", "dark": "#d1d5db" },
    "--text-darker": { "light": "#555", "dark": "#d1d5db" },

    "--bg-primary": { "light": "#ffffff", "dark": "#1a1b1e" },
    "--bg-secondary": { "light": "#f8f9fa", "dark": "#25262b" },
    "--bg-tertiary": { "light": "#f1f3f5", "dark": "#2c2e33" },
    "--bg-elevated": { "light": "#f0f0f0", "dark": "#2c2e33" },
    "--bg-hover": { "light": "#e9ecef", "dark": "#343539" },
